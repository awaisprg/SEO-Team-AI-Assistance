# Database Configuration (PostgreSQL / Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# Supabase Auth & JWT Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Application URL & Port
APP_URL="http://localhost:3000"
PORT=3000

# Gemini AI API Configuration
GEMINI_API_KEY=
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# Trello Configuration (server-side only - never exposed to browser)
TRELLO_MODE="real"
TRELLO_API_KEY=
TRELLO_TOKEN=

# Auth Secret for fallback session signing
AUTH_SECRET="super-secret-auth-key-change-in-production"

# Application Timezone
APP_TIMEZONE="America/New_York"
