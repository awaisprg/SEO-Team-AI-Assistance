# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=
DIRECT_URL=

# Application URL
APP_URL="http://localhost:3000"

# Gemini AI API Configuration
GEMINI_API_KEY=
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
EMBEDDING_MODEL="gemini-embedding-2-preview"

# Optional Alternative AI Providers (OpenAI / Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Trello Configuration (server-side only)
TRELLO_MODE="real"
TRELLO_API_KEY=
TRELLO_TOKEN=

# Auth Secret for session signing
AUTH_SECRET="super-secret-auth-key-change-in-production"

# Application Timezone
APP_TIMEZONE="America/New_York"
